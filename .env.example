# Backend (set these in Render's Environment Variables dashboard)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ilovepdf
PORT=5000

# Frontend (set this in Vercel's Environment Variables dashboard)
# Replace with your actual Render backend URL after deploying the backend first
VITE_API_BASE_URL=https://i-love-pdf-api.onrender.com/api/pdf
